[TEMPLATE]
# ----------------------------------------------------------------------------
# OneOfOne Web - environment template (keys listed alphabetically)
# Copy to `.env` and fill in real values.
# Only VITE_-prefixed vars are exposed to the client bundle (Vite requirement);
# any other var is ignored by the build.
# ----------------------------------------------------------------------------

# Base URL of the OneOfOne API. Defaults to "/api" (same-origin proxy) when
# unset. Point this at the hosted API for local dev, e.g.:
#   https://your-app.onrender.com/api
VITE_API_URL=/api

# Shared secret for scheduler admin actions (trigger/enable/disable/
# trigger-resolution) - sent as the X-Scheduler-Key header.
# Must match SCHEDULER_ADMIN_KEY in the API env.
# Unset in the API -> those endpoints 503 "not configured"; mismatch -> 401.
VITE_SCHEDULER_ADMIN_KEY=<your_key>
