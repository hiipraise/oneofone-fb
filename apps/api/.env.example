[TEMPLATE]
# ----------------------------------------------------------------------------
# OneOfOne API - environment template (keys listed alphabetically)
# Copy to `.env` and fill in real values. Every key below maps to a field on
# app/config/settings.py::Settings (unknown keys are ignored at boot).
# ----------------------------------------------------------------------------

# Comma-separated Host-header allowlist for TrustedHostMiddleware.
# "*" accepts any host (default, needed on containerized/Render deploys).
# Tighten in production, e.g.: api.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=*

# Comma-separated CORS allowlist.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

CACHE_TTL_LONG=86400
CACHE_TTL_MEDIUM=21600
CACHE_TTL_SHORT=3600

CALIBRATION_METHOD=isotonic

DAILY_PREDICTION_HOUR=6
DAILY_PREDICTION_MINUTE=0

DEBUG=false

# Best-effort real expected-goals lookup (Understat, free) at prediction time;
# falls back to the heuristic when the source doesn't cover a fixture.
ENABLE_XG_SCRAPING=true

MIN_TRAINING_SAMPLES=30

# Must match the persisted artifacts in apps/api/models/ (currently v5.0.0).
MODEL_VERSION=5.0.0

MONGODB_DB=oneofone
MONGODB_URI=mongodb://localhost:27017

ODDS_API_KEY=<your_key>

RENDER_APP_URL=<your-render-app-url>

REPORT_ACCURACY_GOOD=0.58
REPORT_ACCURACY_NEEDS=0.55
REPORT_BRIER_GOOD=0.42
REPORT_BRIER_NEEDS=0.50
REPORT_LOW_CONFIDENCE=0.55
REPORT_RESOLUTION_GOOD=0.50

REQUESTS_PER_MINUTE=30

RESULT_RESOLUTION_HOUR=23
RESULT_RESOLUTION_MINUTE=0

# Shared secret for POST /api/scheduler/trigger|enable|disable|trigger-resolution.
# Must match VITE_SCHEDULER_ADMIN_KEY in the web build.
# Unset key -> those endpoints 503 "not configured"; mismatch -> 401.
SCHEDULER_ADMIN_KEY=<your_key>

SCRAPING_DELAY_SECONDS=1.5

SEARCH_CACHE_MAX_ENTRIES=750

SECRET_KEY=<your_secret_key>


# Hard cap with a 100-call buffer under the 2,500/month free limit.
SERPAPI_MONTHLY_BUDGET=2400

# Serper.dev - 2,500 free searches/month
SERPER_API_KEY=<your_key>

# Supported sports for the platform (single-source-of-truth).
SUPPORTED_SPORTS=["soccer"]
