# ─────────────────────────────────────────────────────────────────────────────
# Root .gitignore — public repo safety net
# App-specific ignores live in apps/api/.gitignore and apps/web/.gitignore;
# these entries cover the repo root and anything the nested files miss.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment / secrets (NEVER commit real keys) ──────────────────────────
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
.pypirc
.netrc
.npmrc
.yarnrc
.envrc
secrets.*

# ── Python ───────────────────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
build/
dist/

# ── ML artifacts (models can embed training data) ────────────────────────────
# Uncomment if you stop tracking serialized models:
# *.pkl

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
*.tsbuildinfo

# ── Logs / runtime data ──────────────────────────────────────────────────────
*.log
logs/
data/
*.sqlite3
*.db

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Throwaway / diagnostic scripts ───────────────────────────────────────────
corner_trial.py
trial*.py
scratch*.py
